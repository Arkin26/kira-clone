# Preferred when direct Postgres fails from your machine (P1001 on :5432) — Supabase → Database → Connection string → Transaction pooler
# Password: URL-encode @ as %40. User must be postgres.<ref> for the pooler host.
DATABASE_URL="postgresql://postgres.patngdfckamutexyvcnd:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Alternative — Direct (port 5432), only if reachable from your network:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.patngdfckamutexyvcnd.supabase.co:5432/postgres?sslmode=require"

# Tables: Supabase SQL Editor (see prisma/supabase-manual-ddl.sql). Then: npm run prisma:generate
# Optional seed: npm run prisma:seed

# Solana RPC (must match the cluster you use in the frontend)
RPC_URL="https://api.devnet.solana.com"

# Treasury wallet public key (base58) — must match the merchant receive address the frontend uses (NEXT_PUBLIC_MERCHANT_WALLET)
TREASURY_PUBLIC_KEY="5CqEX4Z25vtDHfDso4kxxjdYzCrvH8u1cWaHo8UZ5usR"

# Optional: require this value in X-API-Key on POST /payments/intent
# API_KEY=""

# EVM (Sepolia) — only needed for eip155 intents
# EVM_RPC_URL="https://rpc.sepolia.org"
# EVM_TREASURY_ADDRESS="0xYourTreasuryAddress"

# Optional: seed ERC-20 allowlist entry (see prisma/seed.ts)
# SEED_SEPOLIA_ERC20_MINT="0x..."

# Privy server verification (GET /auth/me, POST /auth/bind-merchant) — same app as NEXT_PUBLIC_PRIVY_APP_ID
# PRIVY_APP_ID=""
# Optional override; default is https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json
# PRIVY_APP_JWKS_URL=""
