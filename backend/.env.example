# Preferred when direct Postgres fails from your machine (P1001 on :5432) — Supabase → Database → Connection string → Transaction pooler
# Password: URL-encode @ as %40. User must be postgres.<ref> for the pooler host.
DATABASE_URL="postgresql://postgres.patngdfckamutexyvcnd:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Alternative — Direct (port 5432), only if reachable from your network:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.patngdfckamutexyvcnd.supabase.co:5432/postgres?sslmode=require"

# Tables: Supabase SQL Editor. Then: npm run prisma:generate

# Solana Devnet RPC
RPC_URL="https://api.devnet.solana.com"
