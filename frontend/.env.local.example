# Nest API (default backend port 3000)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Solana Devnet
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
# Solscan links (devnet | mainnet-beta)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# Payment intent + on-chain recipient (replace MERCHANT_WALLET with your Devnet pubkey)
NEXT_PUBLIC_MERCHANT_ID=k-intent-demo
NEXT_PUBLIC_MERCHANT_WALLET=5CqEX4Z25vtDHfDso4kxxjdYzCrvH8u1cWaHo8UZ5usR

# Privy (https://dashboard.privy.io) — enables embedded EVM wallets + Log in button
NEXT_PUBLIC_PRIVY_APP_ID=

# Sepolia — must match backend EVM_RPC_URL chain
NEXT_PUBLIC_EVM_RPC_URL=https://rpc.sepolia.org
# Optional: allowlisted ERC-20 mint for USDC on Sepolia (see prisma seed)
NEXT_PUBLIC_SEPOLIA_USDC_MINT=
